# ===== Python 生成物 =====
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ===== 敏感配置（含 caster 账号密码，严禁上传）=====
ntrip_servers.ini

# ===== 采集运行时产物 =====
data/*.txt
# 例外：卫星 TLE 必须入库，前端直接从站点读取（避免被 CelesTrak 限流）
!data/tle-gnss.txt

# ===== 运行时配置（含 Ion Token，由构建注入，严禁入库）=====
config.js
dist/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 本地构建产物（VitePress 首页）=====
site/node_modules/
site/.vitepress/dist/
site/.vitepress/cache/

# ===== 日志 =====
*.log

# ===== 编辑器/IDE =====
.vscode/
.idea/

# ===== WorkBuddy 工作日志（本地专用，不进公开仓库）=====
.workbuddy/
